# Copie para .env e preencha. NUNCA comite o .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=local

# Proxy: em produção, use o domínio (HTTPS automático): SITE_ADDRESS=insights.exemplo.com.br
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# URLs públicas (a API é servida pelo proxy em /api)
API_BASE_URL=http://localhost/api
FRONTEND_URL=http://localhost
# ALLOWED_ORIGINS=http://localhost  (padrão: FRONTEND_URL)
# true em produção (HTTPS). false apenas em desenvolvimento local via HTTP.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Banco (usado pelo compose para montar DATABASE_URL)
POSTGRES_USER=v4
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=v4insights
# Para rodar a API fora do compose:
# DATABASE_URL=postgresql+psycopg://v4:troque-esta-senha@localhost:5432/v4insights
# REDIS_URL=redis://localhost:6379/0

# Chave Fernet para criptografar tokens das integrações. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde fora do banco (secret manager / cofre). Perder a chave exige reconectar integrações.
ENCRYPTION_KEY=

# Login interno (Google Cloud Console > OAuth client "Web application")
# Redirect URI autorizado: ${API_BASE_URL}/auth/google/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Meta Marketing API (app com permissão ads_read aprovada)
# Redirect URI: ${API_BASE_URL}/integracoes/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Google Ads API (OAuth separado do login + developer token aprovado)
# Redirect URI: ${API_BASE_URL}/integracoes/google_ads/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# Sincronização
SYNC_INTERVAL_HOURS=6
SYNC_HISTORY_DAYS_DEFAULT=90
SYNC_MAX_RETRIES=5
SYNC_MAX_CONCURRENCY_PER_PROVIDER=2
