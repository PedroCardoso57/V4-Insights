# Copie para .env e preencha. NUNCA comite o .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=local

# Proxy: em produção, use o domínio (HTTPS automático): SITE_ADDRESS=insights.exemplo.com.br
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Origens públicas. A API responde em ${API_BASE_URL}/api/v1 (o proxy roteia /api ao FastAPI).
API_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
# ALLOWED_ORIGINS=http://localhost  (padrão: FRONTEND_URL)
# true em produção (HTTPS). false apenas em desenvolvimento local via HTTP.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Banco (usado pelo compose para montar DATABASE_URL)
POSTGRES_USER=v4
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=v4insights
# Para rodar a API fora do compose (desenvolvimento: API_BASE_URL=http://localhost:3000,
# FRONTEND_URL=http://localhost:3000 — o Next encaminha /api ao FastAPI):
# DATABASE_URL=postgresql+psycopg://v4:troque-esta-senha@localhost:5432/v4insights
# REDIS_URL=redis://localhost:6379/0

# Chave Fernet para criptografar tokens das integrações. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde fora do banco (secret manager / cofre). Perder a chave exige reconectar integrações.
ENCRYPTION_KEY=
# Rotação: coloque a chave ANTERIOR aqui, troque ENCRYPTION_KEY, rode
# `python -m app.cli rotacionar-chave` e depois esvazie esta variável.
ENCRYPTION_KEYS_PREVIOUS=

# As chaves dos apps abaixo (Google, Meta, Google Ads, LinkedIn, TikTok) também podem ser
# cadastradas pelo sistema, onde têm prioridade: admin e gestor preenchem as que faltam no modal
# de Conectar; ver e trocar todas (Configurações > Chaves das plataformas) só as contas abaixo.
# CHAVES_RESPONSAVEIS_EMAILS=admin@cardosodev.tech
# Login interno (Google Cloud Console > OAuth client "Web application")
# Redirect URI autorizado: ${API_BASE_URL}/api/v1/auth/google/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Meta Marketing API (app com permissão ads_read aprovada)
# Redirect URI: ${API_BASE_URL}/api/v1/integracoes/meta_ads/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Google Ads API (OAuth separado do login + developer token aprovado)
# Redirect URI: ${API_BASE_URL}/api/v1/integracoes/google_ads/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Vazio usa a versão padrão do sistema; versões já desativadas pelo Google também caem nela.
GOOGLE_ADS_API_VERSION=

# LinkedIn Marketing API (app com o produto Advertising API; escopos r_ads e r_ads_reporting)
# Redirect URI: ${API_BASE_URL}/api/v1/integracoes/linkedin_ads/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202410

# TikTok Business API (app aprovado com permissões de Ad Account e Reporting)
# Redirect URI: ${API_BASE_URL}/api/v1/integracoes/tiktok_ads/callback
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=v1.3

# Sincronização
SYNC_INTERVAL_HOURS=6
SYNC_HISTORY_DAYS_DEFAULT=90
SYNC_MAX_RETRIES=5
SYNC_MAX_CONCURRENCY_PER_PROVIDER=2
WORKER_CONCURRENCY=2

# Rate limit "<requisições>/<segundos>" (login por IP; autorizar/sincronizar/PDF por usuário)
RATE_LIMIT_LOGIN=20/60
RATE_LIMIT_LOGIN_EMAIL=10/900
RATE_LIMIT_OPERACOES_CARAS=10/60

# Retenção (LGPD) — validar com o responsável
AUDIT_RETENTION_DAYS=730
SESSIONS_RETENTION_DAYS=30

# Alertas: webhook que aceita JSON {"text": "..."} (Slack, Google Chat, Teams via conector)
ALERT_WEBHOOK_URL=
ALERT_SYNC_FALHAS_CONSECUTIVAS=3
DISK_ALERT_PERCENT=85
BACKUP_MAX_AGE_HOURS=26

# Relatórios (PDFs em volume privado; nunca servidos diretamente pelo proxy)
REPORTS_RETENTION_DAYS=90

# Backup (infra/backup/backup.sh) — o arquivo de senha fica FORA do repositório
BACKUP_PASSPHRASE_FILE=/etc/v4insights/backup.pass
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_INCLUDE_ENV=false
# BACKUP_REMOTE=remoto-rclone:v4-backups
